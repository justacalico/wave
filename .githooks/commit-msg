#!/bin/sh
# Prefix non-conventional subjects with "misc:" so cog check never breaks.
msg_file="$1"
first_line=$(head -n1 "$msg_file")
if ! echo "$first_line" | grep -qE '^(feat|fix|chore|ci|docs|refactor|style|test|perf|revert|build|misc)(\([^)]*\))?!?: .+'; then
  rest=$(tail -n +2 "$msg_file")
  printf 'misc: %s\n%s' "$first_line" "$rest" > "$msg_file"
fi
